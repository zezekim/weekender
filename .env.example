# ---------------------------------------------------------------------------
# Weekender configuration. Copy to .env (scripts/setup.sh does this for you).
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Public hostname (Authelia needs a real hostname, not a bare IP).
#   Local:  weekender.localhost
#   Server: <server-ip>.sslip.io   e.g. 203.0.113.10.sslip.io  (resolves to that IP, free)
APP_DOMAIN=weekender.localhost

# TLS: "internal" = Caddy's local CA (self-signed, for local use).
# On a public server put an email address here to get a free Let's Encrypt cert.
TLS_MODE=internal

# Unprivileged UID/GID the app and Authelia run as (setup.sh fills these in).
PUID=1000
PGID=1000

# Optional — these can also be set (and override) from the protected Settings page.
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=
OPEN_METEO_API_KEY=
# auto | geoapify | google | osm
PLACES_PROVIDER=auto
# Sent in the User-Agent to OpenStreetMap services (their usage policy asks for contact info)
CONTACT_EMAIL=
