{
	admin off
}

# TLS_MODE=internal → Caddy's local CA (local development)
# TLS_MODE=acme     → free Let's Encrypt / ZeroSSL certificate (public server)
(tls_internal) {
	tls internal
}
(tls_acme) {
}

(app_headers) {
	header {
		# Third parties, each for one job: Wikimedia (place photos), OpenFreeMap (map tiles).
		# MapLibre renders in web workers created from blob: URLs.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
	}
}

{$APP_DOMAIN} {
	import tls_{$TLS_MODE:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Never trust identity headers from the client; only Authelia sets these.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name

	# Authelia login portal
	handle /authelia* {
		reverse_proxy authelia:9091
	}

	# Settings page and admin API require a signed-in Authelia user
	@protected path /settings /settings/* /api/admin/*
	handle @protected {
		forward_auth authelia:9091 {
			uri /authelia/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		import app_headers
		reverse_proxy app:8000
	}

	handle {
		import app_headers
		reverse_proxy app:8000
	}
}

# The HTTPS hostname on port 80 always upgrades to HTTPS.
http://{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# Plain HTTP on the bare IP (e.g. http://<server-ip>) serves the public app directly.
# Sign-in and Settings never run over plain HTTP: they redirect to the HTTPS host,
# so passwords and session cookies are only ever sent encrypted.
http:// {
	encode zstd gzip
	header -Server

	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name

	@secure path /settings /settings/* /api/admin/* /authelia /authelia/*
	handle @secure {
		redir https://{$APP_DOMAIN}{uri} 302
	}

	handle {
		import app_headers
		reverse_proxy app:8000
	}
}
